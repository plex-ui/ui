{
  "name": "@plexui/vue",
  "version": "0.1.0",
  "description": "Plex UI components for Vue 3, built on Reka UI and the shared @plexui/styles CSS",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://plexui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/plex-ui/ui.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "plexui",
    "reka-ui",
    "ui-kit"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/es/**",
    "dist/types/**"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "default": "./dist/es/components/*/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "default": "./dist/es/types.js"
    },
    "./theme": {
      "types": "./dist/types/lib/theme.d.ts",
      "default": "./dist/es/lib/theme.js"
    },
    "./helpers": {
      "types": "./dist/types/lib/helpers.d.ts",
      "default": "./dist/es/lib/helpers.js"
    },
    "./userAgent": {
      "types": "./dist/types/lib/userAgent.d.ts",
      "default": "./dist/es/lib/userAgent.js"
    },
    "./dateUtils": {
      "types": "./dist/types/lib/dateUtils.d.ts",
      "default": "./dist/es/lib/dateUtils.js"
    },
    "./composables/*": {
      "types": "./dist/types/composables/*.d.ts",
      "default": "./dist/es/composables/*.js"
    }
  },
  "scripts": {
    "build:clean": "rm -rf dist",
    "build:js": "tsc -p tsconfig.build.json",
    "dev:js": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "npm run build:clean && npm run build:js && npm run dev:js",
    "build": "npm run build:clean && npm run build:js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@plexui/styles": "^0.1.0",
    "@tanstack/vue-table": "8.21.3",
    "@tiptap/core": "3.21.0",
    "@tiptap/extension-bold": "3.21.0",
    "@tiptap/extension-bullet-list": "3.21.0",
    "@tiptap/extension-document": "3.21.0",
    "@tiptap/extension-hard-break": "3.21.0",
    "@tiptap/extension-history": "3.21.0",
    "@tiptap/extension-italic": "3.21.0",
    "@tiptap/extension-link": "3.21.0",
    "@tiptap/extension-list": "3.21.0",
    "@tiptap/extension-list-item": "3.21.0",
    "@tiptap/extension-ordered-list": "3.21.0",
    "@tiptap/extension-paragraph": "3.21.0",
    "@tiptap/extension-placeholder": "3.21.0",
    "@tiptap/extension-text": "3.21.0",
    "@tiptap/extensions": "3.21.0",
    "@tiptap/pm": "3.21.0",
    "@tiptap/vue-3": "3.21.0",
    "clsx": "^2.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "html-url-attributes": "3.0.1",
    "luxon": "3.7.1",
    "refractor": "5.0.0",
    "rehype-katex": "7.0.1",
    "reka-ui": "^2.11.0",
    "remark-breaks": "4.0.0",
    "remark-directive": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tiptap-markdown": "0.9.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "typescript": "5.7.3",
    "vue": "3.5.44"
  }
}
