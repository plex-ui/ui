{
  "name": "@plexui/vue",
  "version": "0.1.0",
  "description": "Plex UI components for Vue 3, built on Reka UI and the shared @plexui/styles CSS",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://plexui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/plex-ui/ui.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "plexui",
    "reka-ui",
    "ui-kit"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/es/**",
    "dist/types/**"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "default": "./dist/es/components/*/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "default": "./dist/es/types.js"
    },
    "./theme": {
      "types": "./dist/types/lib/theme.d.ts",
      "default": "./dist/es/lib/theme.js"
    },
    "./helpers": {
      "types": "./dist/types/lib/helpers.d.ts",
      "default": "./dist/es/lib/helpers.js"
    },
    "./userAgent": {
      "types": "./dist/types/lib/userAgent.d.ts",
      "default": "./dist/es/lib/userAgent.js"
    },
    "./dateUtils": {
      "types": "./dist/types/lib/dateUtils.d.ts",
      "default": "./dist/es/lib/dateUtils.js"
    },
    "./composables/*": {
      "types": "./dist/types/composables/*.d.ts",
      "default": "./dist/es/composables/*.js"
    }
  },
  "scripts": {
    "build:clean": "rm -rf dist",
    "build:js": "tsc -p tsconfig.build.json",
    "dev:js": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "npm run build:clean && npm run build:js && npm run dev:js",
    "build": "npm run build:clean && npm run build:js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@plexui/styles": "^0.1.0",
    "clsx": "^2.1.1",
    "luxon": "3.7.1",
    "reka-ui": "^2.11.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "typescript": "5.7.3",
    "vue": "3.5.44"
  }
}
