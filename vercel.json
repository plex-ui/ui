{
  "framework": "nextjs",
  "buildCommand": "npm run build:styles && npm run build:ui && npm run build:vue && next build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.plexui.com" }],
      "destination": "https://plexui.com/:path",
      "permanent": true
    }
  ]
}
